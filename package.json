{
  "name": "landing-ventilacion",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "desplegar": "astro build && wrangler deploy",
    "sembrar": "node --env-file=.env scripts/sembrar.mjs",
    "tipos": "wrangler types",
    "db:crear": "wrangler d1 create landing-ventilacion",
    "db:migrar": "wrangler d1 migrations apply landing-ventilacion --local",
    "db:migrar:prod": "wrangler d1 migrations apply landing-ventilacion --remote",
    "fotos": "node --env-file=.env scripts/fotos-de-plantilla.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/react": "^6.0.2",
    "@measured/puck": "^0.20.2",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.9.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0"
  }
}
