{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-ventilacion",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Base de datos de las solicitudes de visita.
  //
  // Vive aca y no en Sanity porque el plan gratuito de Sanity solo permite
  // datasets publicos, y "publico" significa que cualquiera con el project ID
  // (que va embebido en el HTML) puede leer todos los documentos. Los nombres,
  // telefonos y direcciones de los clientes no pueden estar ahi.
  //
  // El `database_id` lo devuelve `npx wrangler d1 create landing-ventilacion`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "landing-ventilacion",
      "database_id": "098b55b0-7b2e-4843-84ef-2812b56bfa28"
    }
  ]
}
