---
import { urlImagen } from '../../sanity/imagen';
import type { HeroBloque, Ajustes } from '../../tipos';

interface Props {
  bloque: HeroBloque;
  ajustes: Ajustes;
}

const { bloque, ajustes } = Astro.props;
const foto = bloque.imagen?.asset ? urlImagen(bloque.imagen).width(1200).quality(75).url() : null;
const enlaceWhatsapp = `https://wa.me/${ajustes.whatsapp}?text=${encodeURIComponent(ajustes.mensajeWhatsapp ?? '')}`;
---

{/* Carbon no oscurece el hero ni pone la foto de fondo: el titular vive sobre
    lienzo blanco y la imagen es un bloque plano al costado. */}
<section class="border-b border-filete bg-lienzo">
  <div class="contenedor grid items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
    <div>
      <h1 class="display-xl text-tinta text-balance">{bloque.titular}</h1>

      {bloque.subtitulo && <p class="cuerpo-lg mt-6 max-w-xl text-tinta-media text-pretty">{bloque.subtitulo}</p>}

      <div class="mt-10 flex flex-wrap gap-px">
        <a href="#agendar" class="boton boton-primario">
          {bloque.textoBotonAgendar ?? 'Agendar visita'}
        </a>

        {
          bloque.mostrarBotonWhatsapp !== false && (
            <a href={enlaceWhatsapp} target="_blank" rel="noopener" class="boton boton-whatsapp">
              Escribir por WhatsApp
            </a>
          )
        }
      </div>

      {ajustes.horario && <p class="cuerpo-sm mt-6 text-tinta-media">{ajustes.horario}</p>}
    </div>

    {
      foto && (
        <div class="bg-superficie">
          <img
            src={foto}
            alt={bloque.imagen?.alt ?? ''}
            class="aspect-4/3 w-full object-cover"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>
