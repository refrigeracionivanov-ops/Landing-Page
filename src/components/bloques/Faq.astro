---
import type { FaqBloque } from '../../tipos';

interface Props {
  bloque: FaqBloque;
}

const { bloque } = Astro.props;
---

<section class="contenedor py-20">
  <div class="mx-auto max-w-3xl">
    {bloque.titulo && <h2 class="titulo-seccion text-center">{bloque.titulo}</h2>}

    <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
      {
        bloque.preguntas?.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-marca-900 marker:content-['']">
              {item.pregunta}
              <svg
                class="size-5 shrink-0 text-marca-500 transition group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-slate-600 text-pretty">{item.respuesta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
