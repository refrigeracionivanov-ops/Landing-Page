---
import type { AgendarBloque, Ajustes } from '../../tipos';

interface Props {
  bloque: AgendarBloque;
  ajustes: Ajustes;
  distritos: string[];
}

const { bloque, ajustes, distritos } = Astro.props;

const franjas = ajustes.franjas?.length
  ? ajustes.franjas
  : [
      { etiqueta: 'Manana (8:00 - 12:00)', cupo: 3 },
      { etiqueta: 'Tarde (13:00 - 18:00)', cupo: 3 },
    ];

const SERVICIOS = ['Instalacion', 'Mantenimiento', 'Reparacion', 'Limpieza de ductos', 'Otro / no estoy seguro'];
// "No estoy seguro" va primero a proposito: la mayoria de clientes no sabe que equipo tiene,
// y un formulario que los obliga a saberlo los expulsa.
const EQUIPOS = ['No estoy seguro', 'Split (pared)', 'Ventana', 'Ducteado / central', 'Portatil', 'Extractor / ventilacion'];
---

<section id="agendar" class="banda seccion">
  <div class="contenedor">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        {bloque.titulo && <h2 class="titulo-seccion text-tinta">{bloque.titulo}</h2>}
        {bloque.texto && <p class="cuerpo-lg mt-4 text-tinta-media text-pretty">{bloque.texto}</p>}
        <p class="cuerpo-sm mt-6 border-t border-superficie-2 pt-6 text-tinta-media">
          No cobramos nada por agendar. Confirmamos la hora exacta por WhatsApp.
        </p>
      </div>

      <form id="form-agendar" class="border border-superficie-2 bg-lienzo p-6 sm:p-8" novalidate>
        <!-- Barra de progreso -->
        <div class="mb-8">
          <div class="mb-2 flex items-center justify-between">
            <span id="texto-paso" class="cuerpo-sm text-tinta-media">Paso 1 de 2 — Tus datos</span>
            <span id="pct-paso" class="cuerpo-sm text-tinta-media">50%</span>
          </div>
          <div class="h-1 bg-superficie-2">
            <div id="barra-progreso" class="h-full bg-azul transition-all duration-300" style="width: 50%"></div>
          </div>
        </div>

        <!-- Paso 1: datos de contacto y tipo de servicio -->
        <div id="paso-1">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="etiqueta-campo">Nombre y apellido *</span>
              <input name="nombre" type="text" required autocomplete="name" class="campo" />
            </label>

            <label class="block">
              <span class="etiqueta-campo">Telefono / WhatsApp *</span>
              <input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" class="campo" />
            </label>

            <label class="block">
              <span class="etiqueta-campo">Distrito *</span>
              <select name="distrito" required class="campo">
                <option value="">Elegi tu distrito</option>
                {distritos.map((distrito) => <option value={distrito}>{distrito}</option>)}
                <option value="Otro">Otro (no figura en la lista)</option>
              </select>
            </label>

            <label class="block">
              <span class="etiqueta-campo">Que necesitas *</span>
              <select name="tipoServicio" required class="campo">
                <option value="">Elegi un servicio</option>
                {SERVICIOS.map((servicio) => <option value={servicio}>{servicio}</option>)}
              </select>
            </label>
          </div>

          <button type="button" id="btn-siguiente" class="boton boton-primario mt-8 w-full">
            Siguiente
          </button>
        </div>

        <!-- Paso 2: detalles de la visita -->
        <div id="paso-2" class="hidden">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-2">
              <span class="etiqueta-campo">Direccion *</span>
              <input name="direccion" type="text" required autocomplete="street-address" class="campo" />
            </label>

            <label class="block">
              <span class="etiqueta-campo">Tipo de equipo</span>
              <select name="tipoEquipo" class="campo">
                {EQUIPOS.map((equipo) => <option value={equipo}>{equipo}</option>)}
              </select>
            </label>

            <label class="block">
              <span class="etiqueta-campo">Dia preferido *</span>
              <input name="fechaPreferida" type="date" required class="campo" />
            </label>

            <label class="block sm:col-span-2">
              <span class="etiqueta-campo">Contanos que pasa</span>
              <textarea
                name="descripcion"
                rows="3"
                class="campo"
                placeholder="Ej: el equipo enfria poco y hace ruido desde hace una semana"></textarea>
            </label>

            <fieldset class="block sm:col-span-2">
              <legend class="etiqueta-campo">Franja horaria *</legend>
              <div class="grid gap-px bg-superficie-2 sm:grid-cols-2">
                {
                  franjas.map((franja, indice) => (
                    <label class="cuerpo-sm flex min-h-12 cursor-pointer items-center gap-3 bg-superficie px-4 py-3 text-tinta has-checked:bg-azul has-checked:text-white">
                      <input
                        type="radio"
                        name="franja"
                        value={franja.etiqueta}
                        required
                        checked={indice === 0}
                        class="accent-azul"
                      />
                      {franja.etiqueta}
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>

          {/* Campo trampa: doble proteccion — desplazado visualmente Y oculto semanticamente */}
          <div class="sr-only" aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;">
            <label>
              No completar
              <input name="sitioWeb" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          {/* Notificacion en linea de Carbon: barra de color a la izquierda, sin fondo saturado. */}
          <p
            id="error-agendar"
            class="cuerpo-sm mt-6 hidden border-l-[3px] border-error bg-superficie px-4 py-3 text-tinta"
            role="alert"
          >
          </p>

          <div class="mt-8 flex gap-px">
            <button type="button" id="btn-atras" class="boton boton-terciario">
              Volver
            </button>
            <button type="submit" class="boton boton-primario flex-1">
              Solicitar visita
            </button>
          </div>
        </div>
      </form>
    </div>

    <div id="exito-agendar" class="mt-10 hidden border border-superficie-2 bg-lienzo p-8 lg:max-w-2xl">
      <div class="flex size-12 items-center justify-center bg-exito text-white">
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m5 13 4 4L19 7" />
        </svg>
      </div>
      <h3 class="titulo-tarjeta mt-6 text-tinta">Listo</h3>
      <p class="mt-3 max-w-md text-tinta-media text-pretty">{bloque.mensajeExito}</p>
      <a
        href={`https://wa.me/${ajustes.whatsapp}?text=${encodeURIComponent('Hola, acabo de solicitar una visita por la web y les mando fotos del equipo.')}`}
        target="_blank"
        rel="noopener"
        class="boton boton-whatsapp mt-6"
      >
        Enviar fotos del equipo por WhatsApp
      </a>
      <p class="cuerpo-sm mt-3 text-tinta-media">Con una foto podemos estimar el trabajo antes de ir.</p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ diasAnticipacion: ajustes.diasAnticipacion ?? 1 }}>
  (() => {
    const form = document.getElementById('form-agendar');
    if (!form) return;

    const exito = document.getElementById('exito-agendar');
    const error = document.getElementById('error-agendar');
    const fecha = form.querySelector('input[name="fechaPreferida"]');
    const paso1 = document.getElementById('paso-1');
    const paso2 = document.getElementById('paso-2');
    const btnSiguiente = document.getElementById('btn-siguiente');
    const btnAtras = document.getElementById('btn-atras');
    const textoPaso = document.getElementById('texto-paso');
    const pctPaso = document.getElementById('pct-paso');
    const barraProgreso = document.getElementById('barra-progreso');

    const minimo = new Date();
    minimo.setDate(minimo.getDate() + Number(diasAnticipacion));
    const aIso = (d) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    fecha.min = aIso(minimo);
    fecha.value = aIso(minimo);

    /**
     * Apaga los campos del paso 2 mientras esta oculto.
     *
     * `display:none` NO exime a un campo de la validacion del navegador: solo
     * `disabled` lo hace. Sin esto, `reportValidity()` en el paso 1 falla por
     * los `required` del paso 2, no puede enfocarlos porque estan ocultos, y
     * corta en silencio: el boton "Siguiente" no hace nada.
     *
     * Un campo apagado conserva su valor; solo queda fuera de la validacion y
     * del FormData mientras dura. Al pasar al paso 2 se vuelven a encender.
     */
    const habilitarPaso2 = (encendido) => {
      for (const campo of paso2.querySelectorAll('input, select, textarea')) {
        campo.disabled = !encendido;
      }
    };

    habilitarPaso2(false);

    function irAPaso2() {
      if (!form.reportValidity()) return;
      habilitarPaso2(true);
      paso1.classList.add('hidden');
      paso2.classList.remove('hidden');
      textoPaso.textContent = 'Paso 2 de 2 — Tu visita';
      pctPaso.textContent = '100%';
      barraProgreso.style.width = '100%';
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function irAPaso1() {
      habilitarPaso2(false);
      paso2.classList.add('hidden');
      paso1.classList.remove('hidden');
      textoPaso.textContent = 'Paso 1 de 2 — Tus datos';
      pctPaso.textContent = '50%';
      barraProgreso.style.width = '50%';
    }

    btnSiguiente.addEventListener('click', irAPaso2);
    btnAtras.addEventListener('click', irAPaso1);

    const mostrarError = (mensaje) => {
      error.textContent = mensaje;
      error.classList.remove('hidden');
    };

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      error.classList.add('hidden');

      if (!form.reportValidity()) return;

      const boton = form.querySelector('button[type="submit"]');
      boton.disabled = true;
      boton.textContent = 'Enviando...';

      try {
        const respuesta = await fetch('/api/reservar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        const datos = await respuesta.json().catch(() => ({}));

        if (!respuesta.ok) {
          mostrarError(datos.mensaje ?? 'No pudimos enviar la solicitud. Escribinos por WhatsApp y te atendemos igual.');
          return;
        }

        form.classList.add('hidden');
        exito.classList.remove('hidden');
        exito.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        mostrarError('Parece que se corto la conexion. Escribinos por WhatsApp y te atendemos igual.');
      } finally {
        boton.disabled = false;
        boton.textContent = 'Solicitar visita';
      }
    });
  })();
</script>
