---
import Icono from '../Icono.astro';
import type { ServiciosBloque } from '../../tipos';

interface Props {
  bloque: ServiciosBloque;
}

const { bloque } = Astro.props;
---

<section id="servicios" class="contenedor py-20">
  {bloque.titulo && <h2 class="titulo-seccion text-center">{bloque.titulo}</h2>}
  {bloque.intro && <p class="mx-auto mt-4 max-w-2xl text-center text-slate-600 text-pretty">{bloque.intro}</p>}

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      bloque.servicios?.map((servicio) => (
        <article class="rounded-2xl border border-slate-200 p-6 transition hover:border-marca-500 hover:shadow-md">
          <div class="flex size-12 items-center justify-center rounded-xl bg-marca-50 text-marca-600">
            <Icono nombre={servicio.icono} />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-marca-900">{servicio.nombre}</h3>
          {servicio.descripcion && <p class="mt-2 text-sm text-slate-600">{servicio.descripcion}</p>}
          {
            servicio.precioDesde && (
              <p class="mt-4 text-sm font-semibold text-acento-600">Desde {servicio.precioDesde}</p>
            )
          }
        </article>
      ))
    }
  </div>
</section>
