---
import Icono from '../Icono.astro';
import type { ServiciosBloque } from '../../tipos';

interface Props {
  bloque: ServiciosBloque;
}

const { bloque } = Astro.props;
---

<section id="servicios" class="seccion">
  <div class="contenedor">
    <div class="max-w-2xl">
      {bloque.titulo && <h2 class="titulo-seccion text-tinta">{bloque.titulo}</h2>}
      {bloque.intro && <p class="cuerpo-lg mt-4 text-tinta-media text-pretty">{bloque.intro}</p>}
    </div>

    {/* El fondo del grid es el color de filete y las tarjetas van separadas 1px:
        las lineas resultantes son la grilla de Carbon, sin bordes dobles. */}
    <div class="mt-12 grid gap-px border border-filete bg-filete sm:grid-cols-2 lg:grid-cols-3">
      {
        bloque.servicios?.map((servicio) => (
          <article class="flex flex-col bg-lienzo p-6">
            <Icono nombre={servicio.icono} class="size-8 text-azul" />
            <h3 class="titulo-tarjeta mt-6 text-tinta">{servicio.nombre}</h3>
            {servicio.descripcion && <p class="cuerpo-sm mt-3 grow text-tinta-media">{servicio.descripcion}</p>}
            {
              servicio.precioDesde && (
                <p class="cuerpo-sm mt-6 border-t border-filete pt-4 text-tinta">
                  Desde <span class="font-semibold">{servicio.precioDesde}</span>
                </p>
              )
            }
          </article>
        ))
      }
    </div>
  </div>
</section>
