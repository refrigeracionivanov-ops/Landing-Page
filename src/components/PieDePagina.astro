---
import type { Ajustes } from '../tipos';

interface Props {
  ajustes: Ajustes;
}

const { ajustes } = Astro.props;
const anio = new Date().getFullYear();
---

{/* La unica superficie invertida de toda la pagina. */}
<footer class="inverso bg-inverso text-inverso-tinta-media">
  <div class="contenedor grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="subtitulo text-white">{ajustes.nombre}</p>
      {ajustes.direccion && <p class="cuerpo-sm mt-4">{ajustes.direccion}</p>}
      {ajustes.horario && <p class="cuerpo-sm mt-2">{ajustes.horario}</p>}
    </div>

    <div>
      <p class="cuerpo-sm font-semibold text-white">Contacto</p>
      <p class="cuerpo-sm mt-4">
        <a href={`tel:${ajustes.telefono.replace(/\s/g, '')}`} class="hover:text-white">{ajustes.telefono}</a>
      </p>
      {
        ajustes.email && (
          <p class="cuerpo-sm mt-2">
            <a href={`mailto:${ajustes.email}`} class="hover:text-white">
              {ajustes.email}
            </a>
          </p>
        )
      }
    </div>

    <div>
      <p class="cuerpo-sm font-semibold text-white">Atención</p>
      <p class="cuerpo-sm mt-4">
        <a href="#agendar" class="hover:text-white">Agendar una visita</a>
      </p>
      <p class="cuerpo-sm mt-2">
        <a href={`https://wa.me/${ajustes.whatsapp}`} target="_blank" rel="noopener" class="hover:text-white">
          Escribir por WhatsApp
        </a>
      </p>
    </div>

    <div>
      <p class="cuerpo-sm font-semibold text-white">Servicios</p>
      <p class="cuerpo-sm mt-4"><a href="#servicios" class="hover:text-white">Que hacemos</a></p>
      <p class="cuerpo-sm mt-2"><a href="#cobertura" class="hover:text-white">Zonas de cobertura</a></p>
      <p class="cuerpo-sm mt-2"><a href="#preguntas" class="hover:text-white">Preguntas frecuentes</a></p>
    </div>
  </div>

  <div class="contenedor">
    <div class="border-t border-inverso-2 py-6">
      <p class="leyenda">&copy; {anio} {ajustes.nombre}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
