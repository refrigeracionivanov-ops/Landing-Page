---
import Icono from './Icono.astro';
import type { Ajustes } from '../tipos';

interface Props {
  ajustes: Ajustes;
}

const { ajustes } = Astro.props;
const enlaceWhatsapp = `https://wa.me/${ajustes.whatsapp}?text=${encodeURIComponent(ajustes.mensajeWhatsapp ?? '')}`;
---

{
  ajustes.mostrarBarraContacto !== false && (
    <div
      id="barra-contacto"
      class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t border-filete bg-lienzo md:hidden"
      style="padding-bottom: env(safe-area-inset-bottom)"
    >
      <a
        href={`tel:${ajustes.telefono.replace(/\s/g, '')}`}
        class="cuerpo-sm flex min-h-12 items-center justify-center gap-2 py-4 font-semibold text-azul active:bg-superficie"
      >
        <Icono nombre="telefono" class="size-5" />
        Llamar
      </a>
      <a
        href={enlaceWhatsapp}
        target="_blank"
        rel="noopener"
        class="cuerpo-sm flex min-h-12 items-center justify-center gap-2 bg-whatsapp py-4 font-semibold text-tinta active:bg-whatsapp-oscuro"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2m5.8 14.2c-.2.7-1.2 1.3-2 1.4-.5.1-1.2.2-3.5-.7-2.9-1.2-4.8-4.2-5-4.4s-1.2-1.6-1.2-3 .8-2.1 1-2.4.6-.3.8-.3h.6c.2 0 .4-.1.7.5l.9 2.2c.1.2.2.5 0 .7l-.4.5c-.1.2-.3.3-.1.6s.7 1.2 1.5 1.9c1 .9 1.9 1.2 2.2 1.3s.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l2 1c.3.1.5.2.6.3s.1.7-.1 1.4" />
        </svg>
        WhatsApp
      </a>
    </div>
  )
}
