---
import Hero from './bloques/Hero.tsx';
import Texto from './bloques/Texto.tsx';
import Pasos from './bloques/Pasos.tsx';
import Planes from './bloques/Planes.tsx';
import Aviso from './bloques/Aviso.tsx';
import Servicios from './bloques/Servicios.tsx';
import Beneficios from './bloques/Beneficios.tsx';
import AntesDespues from './bloques/AntesDespues.tsx';
import Cobertura from './bloques/Cobertura.tsx';
import Promociones from './bloques/Promociones.tsx';
import Confianza from './bloques/Confianza.tsx';
import Testimonios from './bloques/Testimonios.tsx';
import Faq from './bloques/Faq.tsx';
import Agendar from './bloques/Agendar.tsx';
import Cta from './bloques/Cta.tsx';
import type { Bloque, Ajustes } from '../tipos';

interface Props {
  secciones?: Bloque[];
  ajustes: Ajustes;
  distritos: string[];
}

const { secciones = [], ajustes, distritos } = Astro.props;

/**
 * Une cada tipo de bloque del panel con su componente.
 * Para sumar un bloque nuevo: se crea el esquema en `bloques.ts`, el componente
 * en `components/bloques/`, y se agrega una linea aca.
 */
const COMPONENTES = {
  heroBloque: Hero,
  textoBloque: Texto,
  pasosBloque: Pasos,
  planesBloque: Planes,
  avisoBloque: Aviso,
  serviciosBloque: Servicios,
  beneficiosBloque: Beneficios,
  antesDespuesBloque: AntesDespues,
  coberturaBloque: Cobertura,
  promocionesBloque: Promociones,
  confianzaBloque: Confianza,
  testimoniosBloque: Testimonios,
  faqBloque: Faq,
  agendarBloque: Agendar,
  ctaBloque: Cta,
} as const;
---

{
  secciones.map((bloque) => {
    /**
     * El unico bloque que llega al navegador.
     *
     * Los demas se renderizan a HTML y ahi termina su trabajo: no tienen nada
     * que responder. Este es un formulario en dos pasos que valida, envia y
     * muestra el resultado, asi que necesita hidratarse. Va aparte del mapa
     * porque una directiva `client:*` tiene que ir sobre el componente escrito,
     * no sobre una variable.
     *
     * `client:load` y no `client:visible`, aunque este al final de la pagina.
     * Con `visible`, React se empieza a descargar recien cuando el formulario
     * entra en pantalla — o sea, justo cuando alguien lo va a usar. Hasta que
     * termina, el boton "Siguiente" es HTML muerto: se ve normal y no responde.
     * Ahorrar esa descarga es exactamente el ahorro que no hay que hacer en el
     * unico bloque que es el objetivo de la pagina.
     */
    if (bloque._type === 'agendarBloque') {
      return <Agendar client:load bloque={bloque as any} ajustes={ajustes} distritos={distritos} />;
    }

    // El `any` es sobre el componente, no sobre el dato: TypeScript intersecta las
    // props de los bloques y el resultado es `never`. El tipo correcto de cada
    // bloque ya lo garantiza su propio componente.
    const Componente = COMPONENTES[bloque._type as keyof typeof COMPONENTES] as any;

    // Un bloque publicado cuyo componente todavia no existe no debe romper la pagina.
    if (!Componente) return null;

    return <Componente bloque={bloque} ajustes={ajustes} distritos={distritos} />;
  })
}
