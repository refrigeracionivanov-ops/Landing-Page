---
import '../styles/comfortair.css';
import type { Ajustes } from '../tipos';
import { fichaDelNegocio } from '../lib/schema';

interface Props {
  titulo: string;
  descripcion?: string;
  ajustes: Ajustes;
  barrios?: string[];
  imagen?: string;
}

const { titulo, descripcion, ajustes, barrios, imagen } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ficha = fichaDelNegocio(ajustes, { url: canonica.href, imagen, barrios });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={canonica} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    {imagen && <meta property="og:image" content={imagen} />}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
      body {
        margin: 0;
        font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        color: #0f172a;
        background: #ffffff;
      }
    </style>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(ficha)} />
  </head>
  <body>
    <slot />
  </body>
</html>
