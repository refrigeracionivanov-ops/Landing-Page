---
import '../styles/global.css';
import { obtenerAjustes } from '../sanity/consultas';

export const prerender = false;

const ajustes = await obtenerAjustes();
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Política de privacidad — {ajustes?.nombre ?? 'Inicio'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-superficie">
    <header class="border-b border-filete bg-lienzo">
      <div class="contenedor flex h-12 items-center justify-between gap-4">
        <a href="/" class="cuerpo-sm font-semibold text-tinta hover:text-azul transition-colors">
          ← {ajustes?.nombre ?? 'Inicio'}
        </a>
      </div>
    </header>

    <main class="contenedor py-12 max-w-3xl">
      <h1 class="display text-tinta">Política de privacidad</h1>
      <p class="cuerpo-sm mt-2 text-tinta-media">Última actualización: {anio}</p>

      <div class="mt-10 space-y-8 cuerpo text-tinta">

        <section>
          <h2 class="subtitulo text-tinta mb-3">¿Quién recopila los datos?</h2>
          <p class="text-tinta-media leading-relaxed">
            {ajustes?.nombre ?? 'Esta empresa'} es responsable del tratamiento de los datos personales
            que ingresás en este sitio web. Podés contactarnos
            {ajustes?.email
              ? ` a través de ${ajustes.email}`
              : ajustes?.whatsapp
              ? ' por WhatsApp'
              : ''}.
          </p>
        </section>

        <section>
          <h2 class="subtitulo text-tinta mb-3">¿Qué datos recopilamos?</h2>
          <p class="text-tinta-media leading-relaxed mb-3">
            Cuando solicitás una visita técnica, guardamos los siguientes datos:
          </p>
          <ul class="cuerpo-sm text-tinta-media space-y-1 list-disc list-inside">
            <li>Nombre y apellido</li>
            <li>Número de teléfono / WhatsApp</li>
            <li>Dirección y barrio</li>
            <li>Tipo de servicio solicitado</li>
            <li>Tipo de equipo</li>
            <li>Descripción del problema (opcional)</li>
            <li>Fecha y franja horaria preferida</li>
          </ul>
        </section>

        <section>
          <h2 class="subtitulo text-tinta mb-3">¿Para qué usamos los datos?</h2>
          <p class="text-tinta-media leading-relaxed">
            Únicamente para coordinar y llevar a cabo la visita técnica que solicitaste.
            No usamos tus datos para publicidad, marketing ni los compartimos con terceros
            fuera de los necesarios para prestar el servicio (como Google Calendar para
            organizar la agenda interna).
          </p>
        </section>

        <section>
          <h2 class="subtitulo text-tinta mb-3">¿Cuánto tiempo los guardamos?</h2>
          <p class="text-tinta-media leading-relaxed">
            Conservamos los datos mientras sean necesarios para prestar el servicio y por un
            plazo de hasta cinco años después de la última interacción, en cumplimiento de
            obligaciones legales y comerciales.
          </p>
        </section>

        <section>
          <h2 class="subtitulo text-tinta mb-3">Tus derechos</h2>
          <p class="text-tinta-media leading-relaxed mb-3">
            De acuerdo con la Ley 25.326 de Protección de los Datos Personales (Argentina),
            tenés derecho a:
          </p>
          <ul class="cuerpo-sm text-tinta-media space-y-1 list-disc list-inside">
            <li>Acceder a los datos que tenemos sobre vos</li>
            <li>Corregir información incorrecta o desactualizada</li>
            <li>Solicitar la eliminación de tus datos</li>
            <li>Oponerte al tratamiento en determinadas circunstancias</li>
          </ul>
          <p class="text-tinta-media leading-relaxed mt-3">
            Para ejercer cualquiera de estos derechos, contactanos
            {ajustes?.email ? (
              <>
                {' '}a{' '}
                <a href={`mailto:${ajustes.email}`} class="text-azul underline">{ajustes.email}</a>
              </>
            ) : ajustes?.whatsapp ? (
              <> por WhatsApp al <a href={`https://wa.me/${ajustes.whatsapp}`} target="_blank" rel="noopener" class="text-azul underline">{ajustes.whatsapp}</a></>
            ) : ''}.
            Respondemos en un plazo máximo de 30 días hábiles.
          </p>
        </section>

        <section>
          <h2 class="subtitulo text-tinta mb-3">Seguridad</h2>
          <p class="text-tinta-media leading-relaxed">
            Los datos se almacenan en servidores seguros con acceso restringido. El sitio
            usa HTTPS en todas las comunicaciones y Cloudflare Turnstile para evitar envíos
            automatizados.
          </p>
        </section>

        <section>
          <h2 class="subtitulo text-tinta mb-3">Cambios en esta política</h2>
          <p class="text-tinta-media leading-relaxed">
            Podemos actualizar esta política cuando sea necesario. La fecha de última
            actualización aparece al inicio de esta página. Si los cambios son sustanciales,
            lo comunicaremos en el sitio.
          </p>
        </section>

      </div>
    </main>

    <footer class="border-t border-filete mt-16">
      <div class="contenedor py-6">
        <p class="leyenda text-tinta-media">&copy; {anio} {ajustes?.nombre}. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
