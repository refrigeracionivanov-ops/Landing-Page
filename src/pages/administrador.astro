---
import { stegaClean } from '@sanity/client/stega';
import '../styles/global.css';
import Editor from '../editor/Editor';
import { obtenerContenido } from '../sanity/consultas';
import { verificarAcceso } from '../lib/acceso';

// Se renderiza en el servidor en cada visita: el editor tiene que abrir con el
// contenido de ahora, no con el del ultimo compilado.
export const prerender = false;

// Misma barrera que /solicitudes. Los endpoints que usa el editor la verifican
// por su cuenta: cerrar solo la pagina dejaria la puerta de atras abierta.
const acceso = await verificarAcceso(Astro.request);

// Si solo falta la clave, se pide; cualquier otro motivo es un problema de
// configuracion y mostrar un formulario ahi seria enganoso.
if (!acceso.autorizado && acceso.pideClave) {
  const fallo = Astro.url.searchParams.has('error');
  return new Response(
    `<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar al administrador</title>
    <meta name="robots" content="noindex" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#f4f4f4;font-family:'IBM Plex Sans',system-ui,sans-serif">
    <form method="POST" action="/api/entrar" style="background:white;padding:32px;width:min(360px,90vw);border:1px solid #e0e0e0;display:grid;gap:16px">
      <div>
        <h1 style="font-size:20px;font-weight:400;margin:0 0 4px;color:#161616">Entrar al administrador</h1>
        <p style="font-size:13px;color:#525252;margin:0">Escribi la clave para continuar.</p>
      </div>
      <input type="hidden" name="destino" value="/administrador" />
      <input type="password" name="clave" required autofocus autocomplete="current-password" aria-label="Clave"
        style="height:40px;font-size:14px;border:1px solid #8d8d8d;border-bottom:1px solid #161616;padding:0 12px;background:#f4f4f4;width:100%;box-sizing:border-box" />
      ${fallo ? '<p style="font-size:13px;color:#da1e28;margin:0">La clave no es correcta.</p>' : ''}
      <button type="submit" style="height:40px;font-size:14px;font-weight:600;background:#0f62fe;color:white;border:0;cursor:pointer">
        Entrar
      </button>
    </form>
  </body>
</html>`,
    { status: 401, headers: { 'content-type': 'text/html; charset=utf-8' } },
  );
}

if (!acceso.autorizado) {
  return new Response(`Sin permiso para entrar al editor. ${acceso.motivo ?? ''}`.trim(), {
    status: 403,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const { pagina, ajustes, distritos } = await obtenerContenido('inicio');

// Sin ajustes no hay telefono, franjas ni nombre del negocio, y la vista previa
// de casi todos los bloques depende de eso. Mismo corte que hace la portada.
if (!ajustes) {
  return new Response(
    'Falta el documento "Ajustes del negocio" en Sanity. Entra a /admin y completalo, o corre `npm run sembrar`.',
    { status: 500, headers: { 'content-type': 'text/plain; charset=utf-8' } },
  );
}

/**
 * Red de seguridad contra los marcadores invisibles de stega.
 *
 * Stega esta apagado en `astro.config.mjs`, asi que hoy esto no encuentra nada.
 * Se deja igual porque el dia que alguien lo vuelva a encender, esta es la
 * pagina que lo paga: aca el texto se edita y se vuelve a guardar, asi que las
 * marcas viajarian de ida y vuelta y quedarian escritas dentro del contenido,
 * acumulandose en cada guardado. Medido cuando estaba encendido: 134.544 de
 * 142.389 caracteres eran marcas.
 */
const contenido = stegaClean({
  secciones: pagina?.secciones ?? [],
  ajustes,
  distritos,
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* El nombre sale del contenido ya limpio: `ajustes` sin pasar por
        stegaClean arrastra las marcas invisibles hasta la pestana. */}
    <title>Editor — {contenido.ajustes.nombre}</title>
    <meta name="robots" content="noindex" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Editor
      client:only="react"
      secciones={contenido.secciones}
      ajustes={contenido.ajustes}
      distritos={contenido.distritos}
    />
  </body>
</html>
