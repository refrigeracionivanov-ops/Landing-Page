---
import { stegaClean } from '@sanity/client/stega';
import '../styles/global.css';
import EditorComfortair from '../editor/EditorComfortair';
import { obtenerContenido } from '../sanity/consultas';
import { verificarAcceso } from '../lib/acceso';

export const prerender = false;

const acceso = await verificarAcceso(Astro.request);

if (!acceso.autorizado && acceso.pideClave) {
  const fallo = Astro.url.searchParams.has('error');
  return new Response(
    `<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar al administrador</title>
    <meta name="robots" content="noindex" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#f1f5f9;font-family:'Inter',system-ui,sans-serif">
    <form method="POST" action="/api/entrar" style="background:white;padding:32px;width:min(360px,90vw);border:1px solid #e2e8f0;border-radius:12px;display:grid;gap:16px;box-shadow:0 1px 3px rgba(0,0,0,.08)">
      <div>
        <h1 style="font-size:20px;font-weight:700;margin:0 0 4px;color:#0f172a">Entrar al administrador</h1>
        <p style="font-size:13px;color:#64748b;margin:0">Escribí la clave para continuar.</p>
      </div>
      <input type="hidden" name="destino" value="/administrador-comfortair" />
      <input type="password" name="clave" required autofocus autocomplete="current-password" aria-label="Clave"
        style="height:42px;font-size:14px;border:1px solid #cbd5e1;border-radius:8px;padding:0 12px;width:100%;box-sizing:border-box;outline:none" />
      ${fallo ? '<p style="font-size:13px;color:#dc2626;margin:0">La clave no es correcta.</p>' : ''}
      <button type="submit" style="height:42px;font-size:14px;font-weight:600;background:#2563eb;color:white;border:0;border-radius:8px;cursor:pointer">
        Entrar
      </button>
    </form>
  </body>
</html>`,
    { status: 401, headers: { 'content-type': 'text/html; charset=utf-8' } },
  );
}

if (!acceso.autorizado) {
  return new Response(`Sin permiso para entrar al editor. ${acceso.motivo ?? ''}`.trim(), {
    status: 403,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const { pagina, ajustes, distritos } = await obtenerContenido('comfortair');

if (!ajustes) {
  return new Response(
    'Falta el documento "Ajustes del negocio" en Sanity. Entra a /admin y completalo.',
    { status: 500, headers: { 'content-type': 'text/plain; charset=utf-8' } },
  );
}

const contenido = stegaClean({
  secciones: pagina?.secciones ?? [],
  ajustes,
  distritos,
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editor ComfortAir — {contenido.ajustes.nombre}</title>
    <meta name="robots" content="noindex" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <EditorComfortair
      client:only="react"
      secciones={contenido.secciones}
      ajustes={contenido.ajustes}
      distritos={contenido.distritos}
    />
  </body>
</html>
