---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { verificarAcceso } from '../lib/acceso';
import {
  actualizarSolicitud,
  contarPorEstado,
  listarSolicitudes,
  marcarResenaPedida,
  moverSolicitud,
  proximoHueco,
  solicitudesEntre,
  vaciarSpam,
  ESTADOS,
  ESTADOS_VISIBLES,
} from '../lib/solicitudes';
import { obtenerAjustes } from '../sanity/consultas';
import { paraLlamar, paraWhatsapp } from '../lib/telefono';
import { sincronizar } from '../lib/calendario';

// Datos personales: nunca se genera de forma estatica ni se cachea.
export const prerender = false;

const acceso = await verificarAcceso(Astro.request);

// Mientras la puerta sea por clave, se pide; con Cloudflare Access delante esta
// rama no ocurre nunca porque el borde ya filtro.
if (!acceso.autorizado && acceso.pideClave) {
  return Astro.redirect('/entrar?destino=/solicitudes');
}

if (!acceso.autorizado) {
  return new Response(
    `Acceso denegado. ${acceso.motivo ?? ''}`,
    { status: 403, headers: { 'Content-Type': 'text/plain; charset=utf-8' } },
  );
}

const db = env.DB;

if (!db) {
  return new Response('Falta el binding D1 "DB". Revisa wrangler.jsonc.', { status: 500 });
}

const hoy = () => new Date().toISOString().slice(0, 10);

const sumarUnDia = (iso: string) => {
  const fecha = new Date(`${iso}T00:00:00Z`);
  fecha.setUTCDate(fecha.getUTCDate() + 1);
  return fecha.toISOString().slice(0, 10);
};

// Las franjas y su cupo salen de los ajustes, y "posponer" las necesita antes
// de responder, asi que se cargan antes de atender el POST.
const ajustesDelNegocio = await obtenerAjustes();

// Guardar y redirigir: evita que recargar la pagina repita el ultimo cambio.
if (Astro.request.method === 'POST') {
  const formulario = await Astro.request.formData();
  const id = Number(formulario.get('id'));

  /**
   * Pedir la resena: se anota que se pidio y se abre WhatsApp.
   *
   * El destino lo arma el servidor y no el navegador porque aca esta el numero
   * del cliente y el enlace de Google. Va en una pestana nueva (el formulario
   * lleva target), asi que la lista queda donde estaba.
   */
  if (formulario.get('accion') === 'resena' && Number.isInteger(id) && id > 0) {
    const destino = String(formulario.get('destino') ?? '');
    await marcarResenaPedida(db, id);

    if (destino.startsWith('https://wa.me/')) return Astro.redirect(destino, 303);
    return Astro.redirect('/solicitudes', 303);
  }

  const accion = String(formulario.get('accion') ?? '');

  /**
   * Vaciar el spam: el unico borrado real del sistema.
   *
   * Todo lo demas cambia de estado. Esto saca las filas de la base, y por eso
   * es una accion aparte y explicita, en su propia vista, y no un boton al
   * lado de cada solicitud.
   */
  if (accion === 'vaciar-spam') {
    const borradas = await vaciarSpam(db);
    return Astro.redirect(`/solicitudes?estado=spam&aviso=vaciado&n=${borradas}`, 303);
  }

  let espejoOk = true;
  let avisoPosponer = '';

  if (Number.isInteger(id) && id > 0) {
    if (accion === 'posponer') {
      /**
       * Mueve la visita al primer hueco libre, empezando por el dia siguiente
       * al que tenia. Si en tres semanas no hay lugar, no toca nada: el
       * problema no lo resuelve mover una visita.
       */
      const ajustesFranjas = ajustesDelNegocio?.franjas ?? [];
      const actual = (await listarSolicitudes(db)).find((s) => s.id === id);
      const desde = actual ? sumarUnDia(actual.fecha_preferida) : hoy();
      const hueco = await proximoHueco(db, desde, ajustesFranjas);

      if (hueco) {
        await moverSolicitud(db, id, hueco.fecha, hueco.franja);
        avisoPosponer = 'pospuesta';
      } else {
        avisoPosponer = 'sin-hueco';
      }
    } else {
      // `aceptar` y `spam` son atajos de un clic al mismo cambio de estado que
      // hace el desplegable: un estado por boton, sin campo intermedio.
      const estado =
        accion === 'aceptar' ? 'agendada' : accion === 'spam' ? 'spam' : String(formulario.get('estado') ?? '');

      await actualizarSolicitud(db, id, {
        estado: estado || undefined,
        notas: formulario.has('notas') ? String(formulario.get('notas')).slice(0, 2000) : undefined,
      });
    }

    // El calendario se alinea despues de guardar, no antes: si Google falla,
    // el cambio de estado igual quedo registrado.
    espejoOk = await sincronizar(db, id);
  }

  const destino = new URL(Astro.url);
  destino.searchParams.delete('aviso');
  destino.searchParams.delete('n');
  if (avisoPosponer) destino.searchParams.set('aviso', avisoPosponer);
  if (!espejoOk) destino.searchParams.set('aviso', 'calendario');

  return Astro.redirect(`${destino.pathname}${destino.search}`, 303);
}

const filtro = Astro.url.searchParams.get('estado') ?? '';
const enCalendario = Astro.url.searchParams.get('vista') === 'calendario';

const [solicitudes, totales] = await Promise.all([listarSolicitudes(db, filtro), contarPorEstado(db)]);
const ajustes = ajustesDelNegocio;
// "Todas" no cuenta el spam: tiene que coincidir con lo que se ve al entrar.
const total = ESTADOS_VISIBLES.reduce((suma, estado) => suma + (totales[estado] ?? 0), 0);

/**
 * Las proximas dos semanas, dia por dia y franja por franja.
 *
 * La agenda de este negocio no son horas exactas sino cupos: lo que hace falta
 * ver de un vistazo no es "que hay a las 14", sino que dias quedan libres para
 * poder ofrecerlos por telefono. Por eso cada franja muestra ocupados sobre
 * total y no una grilla horaria.
 */
const DIAS_VISIBLES = 14;
const franjasDelNegocio = ajustes?.franjas?.length
  ? ajustes.franjas
  : [{ etiqueta: 'Mañana (8:00 - 12:00)', cupo: 3 }];

const desde = hoy();
const hasta = (() => {
  const f = new Date(`${desde}T00:00:00Z`);
  f.setUTCDate(f.getUTCDate() + DIAS_VISIBLES - 1);
  return f.toISOString().slice(0, 10);
})();

const enRango = enCalendario ? await solicitudesEntre(db, desde, hasta) : [];

const agenda = Array.from({ length: DIAS_VISIBLES }, (_, i) => {
  const f = new Date(`${desde}T00:00:00Z`);
  f.setUTCDate(f.getUTCDate() + i);
  const fecha = f.toISOString().slice(0, 10);

  return {
    fecha,
    franjas: franjasDelNegocio.map(({ etiqueta, cupo }) => {
      const visitas = enRango.filter((s) => s.fecha_preferida === fecha && s.franja === etiqueta);
      // El cupo lo ocupan las que siguen vivas; una cancelada libera el lugar.
      const ocupadas = visitas.filter((s) => ['nueva', 'contactada', 'agendada'].includes(s.estado));
      return { etiqueta, cupo, visitas, ocupadas: ocupadas.length, lleno: ocupadas.length >= cupo };
    }),
  };
});

const nombreDelDia = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' });

const aviso = Astro.url.searchParams.get('aviso');

// Etiquetas de estado con la paleta de tags de Carbon (tono 20 de fondo, 70 de texto).
const COLORES: Record<string, string> = {
  nueva: 'bg-[#d0e2ff] text-[#0043ce]',
  contactada: 'bg-[#e8daff] text-[#6929c4]',
  agendada: 'bg-[#a7f0ba] text-[#0e6027]',
  completada: 'bg-superficie-2 text-tinta-media',
  cancelada: 'bg-[#ffd7d9] text-[#a2191f]',
};

/* El numero se guarda como lo escribio el cliente. Para WhatsApp hace falta el
   formato internacional con el 9 de los moviles: ver src/lib/telefono.ts. */

/**
 * El mensaje que se le manda al cliente, con su nombre y el enlace al final.
 *
 * Solo el primer nombre: "Hola Juan Carlos Perez" suena a formulario, y lo que
 * hace que alguien conteste es que parezca escrito por una persona.
 */
const mensajeResena = (nombre: string) => {
  const plantilla =
    ajustes?.mensajeResena?.trim() ||
    'Hola {nombre}, gracias por confiar en nosotros. Si quedaste conforme con la visita, nos ayudaría muchísimo una reseña en Google. Te toma un minuto:';

  return `${plantilla.replace('{nombre}', nombre.trim().split(/\s+/)[0])}
${ajustes?.googleResenas ?? ''}`;
};

const formatearPedido = (fecha: string) =>
  new Date(fecha.replace(' ', 'T') + 'Z').toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });

const formatearFecha = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('es-AR', { weekday: 'short', day: 'numeric', month: 'short' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Solicitudes de visita</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-superficie">
    <header class="border-b border-filete bg-lienzo">
      <div class="contenedor flex h-12 items-center justify-between">
        <h1 class="cuerpo-sm font-semibold text-tinta">Solicitudes de visita</h1>
        <span class="leyenda text-tinta-media">{acceso.email}</span>
      </div>
    </header>

    <main class="contenedor py-8">
      {
        aviso === 'pospuesta' && (
          <p class="cuerpo-sm mt-6 border-l-[3px] border-exito bg-superficie px-4 py-3 text-tinta" role="status">
            Movida al próximo día con lugar. Avisale al cliente por WhatsApp: el cambio lo hiciste vos, no él.
          </p>
        )
      }

      {
        aviso === 'sin-hueco' && (
          <p class="cuerpo-sm mt-6 border-l-[3px] border-error bg-superficie px-4 py-3 text-tinta" role="alert">
            No hay lugar en las próximas tres semanas. Si esto pasa seguido, subí el cupo por franja en Ajustes.
          </p>
        )
      }

      {
        aviso === 'vaciado' && (
          <p class="cuerpo-sm mt-6 border-l-[3px] border-exito bg-superficie px-4 py-3 text-tinta" role="status">
            Spam borrado: {Astro.url.searchParams.get('n') ?? 0} solicitudes. Eso sí no se recupera.
          </p>
        )
      }

      {
        aviso === 'calendario' && (
          <p class="cuerpo-sm mb-6 border-l-[3px] border-advertencia bg-lienzo px-4 py-3 text-tinta" role="alert">
            El cambio se guardo, pero no se pudo actualizar Google Calendar. Revisa el evento a mano.
          </p>
        )
      }

      {/* Pestanas de Carbon: subrayado de 2px, no pastillas. */}
      <nav class="flex gap-px border-b border-filete">
        <a
          href="/solicitudes"
          class:list={[
            'cuerpo-sm flex min-h-12 items-center border-b-2 px-5 font-semibold',
            !enCalendario ? 'border-azul text-tinta' : 'border-transparent text-tinta-media',
          ]}
        >
          Solicitudes
        </a>
        <a
          href="/solicitudes?vista=calendario"
          class:list={[
            'cuerpo-sm flex min-h-12 items-center border-b-2 px-5 font-semibold',
            enCalendario ? 'border-azul text-tinta' : 'border-transparent text-tinta-media',
          ]}
        >
          Agenda
        </a>
      </nav>

      {
        !enCalendario && (
          <nav class="flex flex-wrap border-b border-filete">
            <a
              href="/solicitudes"
              class:list={[
                'cuerpo-sm flex min-h-12 items-center border-b-2 px-4',
                filtro === '' ? 'border-azul font-semibold text-tinta' : 'border-transparent text-tinta-media',
              ]}
            >
              Todas ({total})
            </a>
            {ESTADOS_VISIBLES.map((estado) => (
              <a
                href={`/solicitudes?estado=${estado}`}
                class:list={[
                  'cuerpo-sm flex min-h-12 items-center border-b-2 px-4 capitalize',
                  filtro === estado ? 'border-azul font-semibold text-tinta' : 'border-transparent text-tinta-media',
                ]}
              >
                {estado} ({totales[estado] ?? 0})
              </a>
            ))}

            {/* El spam vive aparte: lo que se marco como basura no tiene por que
                ocupar un lugar en la fila de trabajo del dia. */}
            {(totales.spam ?? 0) > 0 && (
              <a
                href="/solicitudes?estado=spam"
                class:list={[
                  'cuerpo-sm ml-auto flex min-h-12 items-center border-b-2 px-4',
                  filtro === 'spam' ? 'border-azul font-semibold text-tinta' : 'border-transparent text-tinta-suave',
                ]}
              >
                Spam ({totales.spam})
              </a>
            )}
          </nav>
        )
      }

      {
        enCalendario && (
          <div class="mt-8 space-y-px">
            <p class="cuerpo-sm mb-6 text-tinta-media">
              Las próximas dos semanas. Cada franja muestra cuántas visitas tenés sobre el cupo que aceptás.
            </p>

            {agenda.map((dia) => {
              const ocupadasDelDia = dia.franjas.reduce((suma, f) => suma + f.ocupadas, 0);

              return (
                <article
                  class:list={[
                    'grid gap-4 border border-filete p-5 sm:grid-cols-[200px_1fr]',
                    ocupadasDelDia ? 'bg-lienzo' : 'bg-superficie',
                  ]}
                >
                  {/* `first-letter` y no `capitalize`: este ultimo pone mayuscula
                      en cada palabra y deja "19 De Agosto". */}
                  <p
                    class:list={[
                      'cuerpo-sm first-letter:uppercase',
                      ocupadasDelDia ? 'font-semibold text-tinta' : 'text-tinta-media',
                    ]}
                  >
                    {nombreDelDia(dia.fecha)}
                  </p>

                  <div class="space-y-3">
                    {dia.franjas.map((franja) => (
                      <div>
                        <div class="flex flex-wrap items-center gap-3">
                          <span class="cuerpo-sm text-tinta-media">{franja.etiqueta}</span>
                          <span
                            class:list={[
                              'leyenda px-2 py-1 font-semibold',
                              franja.lleno ? 'bg-[#ffd7d9] text-[#a2191f]' : 'bg-superficie-2 text-tinta-media',
                            ]}
                          >
                            {franja.ocupadas} de {franja.cupo}
                            {franja.lleno ? ' — completa' : ''}
                          </span>
                        </div>

                        {franja.visitas.length > 0 && (
                          <ul class="mt-2 space-y-1">
                            {franja.visitas.map((visita) => (
                              <li class="cuerpo-sm flex flex-wrap items-center gap-2">
                                <span class:list={['leyenda px-2 py-0.5 font-semibold capitalize', COLORES[visita.estado]]}>
                                  {visita.estado}
                                </span>
                                <span class="text-tinta">{visita.nombre}</span>
                                <span class="text-tinta-media">— {visita.distrito}, {visita.direccion}</span>
                                <a
                                  href={`https://wa.me/${paraWhatsapp(visita.telefono)}`}
                                  target="_blank"
                                  rel="noopener"
                                  class="text-azul underline"
                                >
                                  WhatsApp
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                </article>
              );
            })}
          </div>
        )
      }

      {
        !enCalendario && filtro === 'spam' && solicitudes.length > 0 && (
          <form method="POST" class="mt-8 border border-error bg-superficie p-5">
            <input type="hidden" name="accion" value="vaciar-spam" />
            <p class="cuerpo-sm text-tinta">
              Borrar definitivamente {solicitudes.length === 1 ? 'la solicitud marcada' : `las ${solicitudes.length} solicitudes marcadas`}{' '}
              como spam. Es el único borrado del sistema y no se puede deshacer.
            </p>
            <button type="submit" class="boton boton-terciario mt-4">
              Vaciar spam
            </button>
          </form>
        )
      }

      {
        enCalendario ? null : solicitudes.length === 0 ? (
          <p class="mt-12 text-tinta-media">No hay solicitudes en esta vista.</p>
        ) : (
          <div class="mt-6 space-y-px">
            {solicitudes.map((solicitud) => (
              <article class="border border-filete bg-lienzo p-6">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <h2 class="subtitulo text-tinta">{solicitud.nombre}</h2>
                      <span
                        class:list={['leyenda px-2 py-1 font-semibold capitalize', COLORES[solicitud.estado]]}
                      >
                        {solicitud.estado}
                      </span>
                    </div>
                    <p class="cuerpo-sm mt-2 text-tinta-media">
                      {solicitud.distrito} — {solicitud.direccion}
                    </p>
                  </div>

                  <div class="text-right">
                    <p class="cuerpo-sm font-semibold text-tinta">{formatearFecha(solicitud.fecha_preferida)}</p>
                    <p class="leyenda text-tinta-media">{solicitud.franja}</p>
                  </div>
                </div>

                <dl class="cuerpo-sm mt-5 grid gap-x-6 gap-y-2 sm:grid-cols-2">
                  <div class="flex gap-2">
                    <dt class="text-tinta-media">Servicio:</dt>
                    <dd class="font-semibold text-tinta">{solicitud.tipo_servicio}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="text-tinta-media">Equipo:</dt>
                    <dd class="font-semibold text-tinta">{solicitud.tipo_equipo ?? '—'}</dd>
                  </div>
                  {solicitud.descripcion && (
                    <div class="flex gap-2 sm:col-span-2">
                      <dt class="shrink-0 text-tinta-media">Problema:</dt>
                      <dd class="text-tinta">{solicitud.descripcion}</dd>
                    </div>
                  )}
                </dl>

                <div class="mt-5 flex flex-wrap gap-px">
                  <a
                    href={`https://wa.me/${paraWhatsapp(solicitud.telefono)}`}
                    target="_blank"
                    rel="noopener"
                    class="boton boton-whatsapp"
                  >
                    WhatsApp
                  </a>
                  <a href={`tel:${paraLlamar(solicitud.telefono)}`} class="boton boton-terciario">
                    {solicitud.telefono}
                  </a>

                  {/*
                    Solo despues de la visita, y solo si hay enlace cargado en Ajustes.
                    Pedir una resena antes de que el trabajo este hecho es la mejor
                    forma de que no te la dejen — o de que te dejen una mala.
                  */}
                  {solicitud.estado === 'completada' && ajustes?.googleResenas && (
                    <form method="POST" target="_blank" class="contents">
                      <input type="hidden" name="accion" value="resena" />
                      <input type="hidden" name="id" value={solicitud.id} />
                      <input
                        type="hidden"
                        name="destino"
                        value={`https://wa.me/${paraWhatsapp(solicitud.telefono)}?text=${encodeURIComponent(
                          mensajeResena(solicitud.nombre),
                        )}`}
                      />
                      <button
                        type="submit"
                        class:list={['boton', solicitud.resena_pedida_en ? 'boton-terciario' : 'boton-primario']}
                      >
                        {solicitud.resena_pedida_en
                          ? `Reseña pedida el ${formatearPedido(solicitud.resena_pedida_en)}`
                          : 'Pedir reseña en Google'}
                      </button>
                    </form>
                  )}
                </div>

                {/*
                  Un boton por decision frecuente, en vez de obligar a pasar por
                  el desplegable para las tres cosas que se hacen todo el dia.
                  El desplegable queda abajo para el resto de los estados.
                */}
                <div class="mt-5 flex flex-wrap gap-px border-t border-filete pt-5">
                  {solicitud.estado !== 'agendada' && solicitud.estado !== 'spam' && (
                    <form method="POST" class="contents">
                      <input type="hidden" name="id" value={solicitud.id} />
                      <input type="hidden" name="accion" value="aceptar" />
                      <button type="submit" class="boton boton-primario">
                        Aceptar la visita
                      </button>
                    </form>
                  )}

                  {solicitud.estado !== 'spam' && (
                    <form method="POST" class="contents">
                      <input type="hidden" name="id" value={solicitud.id} />
                      <input type="hidden" name="accion" value="posponer" />
                      <button type="submit" class="boton boton-terciario">
                        Posponer al próximo hueco
                      </button>
                    </form>
                  )}

                  <form method="POST" class="contents">
                    <input type="hidden" name="id" value={solicitud.id} />
                    <input type="hidden" name="accion" value={solicitud.estado === 'spam' ? 'aceptar' : 'spam'} />
                    <button type="submit" class="boton boton-terciario">
                      {solicitud.estado === 'spam' ? 'No era spam' : 'Marcar como spam'}
                    </button>
                  </form>
                </div>

                <form method="POST" class="mt-4 flex flex-wrap items-end gap-4">
                  <input type="hidden" name="id" value={solicitud.id} />

                  <label class="block">
                    <span class="etiqueta-campo">Estado</span>
                    <select name="estado" class="campo capitalize">
                      {ESTADOS.map((estado) => (
                        <option value={estado} selected={estado === solicitud.estado}>
                          {estado}
                        </option>
                      ))}
                    </select>
                  </label>

                  <label class="block grow">
                    <span class="etiqueta-campo">Notas internas</span>
                    <input type="text" name="notas" value={solicitud.notas ?? ''} class="campo" />
                  </label>

                  <button type="submit" class="boton boton-primario">
                    Guardar
                  </button>
                </form>
              </article>
            ))}
          </div>
        )
      }
    </main>
  </body>
</html>
