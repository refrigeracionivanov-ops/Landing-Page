---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { verificarAcceso } from '../lib/acceso';
import { actualizarSolicitud, contarPorEstado, listarSolicitudes, ESTADOS } from '../lib/solicitudes';
import { sincronizar } from '../lib/calendario';

// Datos personales: nunca se genera de forma estatica ni se cachea.
export const prerender = false;

const acceso = await verificarAcceso(Astro.request);

if (!acceso.autorizado) {
  return new Response(
    `Acceso denegado. ${acceso.motivo ?? ''}`,
    { status: 403, headers: { 'Content-Type': 'text/plain; charset=utf-8' } },
  );
}

const db = env.DB;

if (!db) {
  return new Response('Falta el binding D1 "DB". Revisa wrangler.jsonc.', { status: 500 });
}

// Guardar y redirigir: evita que recargar la pagina repita el ultimo cambio.
if (Astro.request.method === 'POST') {
  const formulario = await Astro.request.formData();
  const id = Number(formulario.get('id'));

  let espejoOk = true;

  if (Number.isInteger(id) && id > 0) {
    await actualizarSolicitud(db, id, {
      estado: String(formulario.get('estado') ?? '') || undefined,
      notas: formulario.has('notas') ? String(formulario.get('notas')).slice(0, 2000) : undefined,
    });

    // El calendario se alinea despues de guardar, no antes: si Google falla,
    // el cambio de estado igual quedo registrado.
    espejoOk = await sincronizar(db, id);
  }

  const destino = new URL(Astro.url);
  destino.searchParams.delete('aviso');
  if (!espejoOk) destino.searchParams.set('aviso', 'calendario');

  return Astro.redirect(`${destino.pathname}${destino.search}`, 303);
}

const filtro = Astro.url.searchParams.get('estado') ?? '';
const [solicitudes, totales] = await Promise.all([listarSolicitudes(db, filtro), contarPorEstado(db)]);
const total = Object.values(totales).reduce((a, b) => a + b, 0);

const COLORES: Record<string, string> = {
  nueva: 'bg-acento-500/15 text-acento-600',
  contactada: 'bg-marca-100 text-marca-700',
  agendada: 'bg-whatsapp/15 text-whatsapp-oscuro',
  completada: 'bg-slate-100 text-slate-600',
  cancelada: 'bg-red-50 text-red-600',
};

const soloDigitos = (telefono: string) => telefono.replace(/\D/g, '');

const formatearFecha = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('es-PE', { weekday: 'short', day: 'numeric', month: 'short' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Solicitudes de visita</title>
  </head>

  <body class="bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
      <div class="contenedor flex h-16 items-center justify-between">
        <h1 class="text-lg font-bold text-marca-900">Solicitudes de visita</h1>
        <span class="text-xs text-slate-500">{acceso.email}</span>
      </div>
    </header>

    <main class="contenedor py-8">
      {
        Astro.url.searchParams.get('aviso') === 'calendario' && (
          <p class="mb-6 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800" role="alert">
            El cambio se guardo, pero no se pudo actualizar Google Calendar. Revisa el evento a mano.
          </p>
        )
      }

      <nav class="flex flex-wrap gap-2">
        <a
          href="/solicitudes"
          class:list={[
            'rounded-full px-4 py-1.5 text-sm font-medium',
            filtro === '' ? 'bg-marca-600 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200',
          ]}
        >
          Todas ({total})
        </a>
        {
          ESTADOS.map((estado) => (
            <a
              href={`/solicitudes?estado=${estado}`}
              class:list={[
                'rounded-full px-4 py-1.5 text-sm font-medium capitalize',
                filtro === estado ? 'bg-marca-600 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200',
              ]}
            >
              {estado} ({totales[estado] ?? 0})
            </a>
          ))
        }
      </nav>

      {
        solicitudes.length === 0 ? (
          <p class="mt-12 text-center text-slate-500">No hay solicitudes en esta vista.</p>
        ) : (
          <div class="mt-6 space-y-4">
            {solicitudes.map((solicitud) => (
              <article class="rounded-2xl border border-slate-200 bg-white p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h2 class="font-semibold text-marca-900">{solicitud.nombre}</h2>
                      <span
                        class:list={[
                          'rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize',
                          COLORES[solicitud.estado],
                        ]}
                      >
                        {solicitud.estado}
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-slate-600">
                      {solicitud.distrito} — {solicitud.direccion}
                    </p>
                  </div>

                  <div class="text-right">
                    <p class="text-sm font-semibold text-marca-700">{formatearFecha(solicitud.fecha_preferida)}</p>
                    <p class="text-xs text-slate-500">{solicitud.franja}</p>
                  </div>
                </div>

                <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
                  <div class="flex gap-2">
                    <dt class="text-slate-500">Servicio:</dt>
                    <dd class="font-medium text-slate-800">{solicitud.tipo_servicio}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="text-slate-500">Equipo:</dt>
                    <dd class="font-medium text-slate-800">{solicitud.tipo_equipo ?? '—'}</dd>
                  </div>
                  {solicitud.descripcion && (
                    <div class="flex gap-2 sm:col-span-2">
                      <dt class="shrink-0 text-slate-500">Problema:</dt>
                      <dd class="text-slate-800">{solicitud.descripcion}</dd>
                    </div>
                  )}
                </dl>

                <div class="mt-4 flex flex-wrap gap-2">
                  <a
                    href={`https://wa.me/${soloDigitos(solicitud.telefono)}`}
                    target="_blank"
                    rel="noopener"
                    class="rounded-lg bg-whatsapp px-4 py-2 text-sm font-semibold text-white"
                  >
                    WhatsApp
                  </a>
                  <a
                    href={`tel:${soloDigitos(solicitud.telefono)}`}
                    class="rounded-lg bg-marca-50 px-4 py-2 text-sm font-semibold text-marca-700"
                  >
                    {solicitud.telefono}
                  </a>
                </div>

                <form method="POST" class="mt-4 flex flex-wrap items-end gap-3 border-t border-slate-100 pt-4">
                  <input type="hidden" name="id" value={solicitud.id} />

                  <label class="block">
                    <span class="mb-1 block text-xs font-medium text-slate-500">Estado</span>
                    <select
                      name="estado"
                      class="rounded-lg border border-slate-300 px-3 py-2 text-sm capitalize"
                    >
                      {ESTADOS.map((estado) => (
                        <option value={estado} selected={estado === solicitud.estado}>
                          {estado}
                        </option>
                      ))}
                    </select>
                  </label>

                  <label class="block grow">
                    <span class="mb-1 block text-xs font-medium text-slate-500">Notas internas</span>
                    <input
                      type="text"
                      name="notas"
                      value={solicitud.notas ?? ''}
                      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                    />
                  </label>

                  <button
                    type="submit"
                    class="rounded-lg bg-marca-600 px-5 py-2 text-sm font-semibold text-white hover:bg-marca-700"
                  >
                    Guardar
                  </button>
                </form>
              </article>
            ))}
          </div>
        )
      }
    </main>
  </body>
</html>
