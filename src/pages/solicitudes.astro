---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { verificarAcceso } from '../lib/acceso';
import { actualizarSolicitud, contarPorEstado, listarSolicitudes, ESTADOS } from '../lib/solicitudes';
import { sincronizar } from '../lib/calendario';

// Datos personales: nunca se genera de forma estatica ni se cachea.
export const prerender = false;

const acceso = await verificarAcceso(Astro.request);

// Mientras la puerta sea por clave, se pide; con Cloudflare Access delante esta
// rama no ocurre nunca porque el borde ya filtro.
if (!acceso.autorizado && acceso.pideClave) {
  return Astro.redirect('/entrar?destino=/solicitudes');
}

if (!acceso.autorizado) {
  return new Response(
    `Acceso denegado. ${acceso.motivo ?? ''}`,
    { status: 403, headers: { 'Content-Type': 'text/plain; charset=utf-8' } },
  );
}

const db = env.DB;

if (!db) {
  return new Response('Falta el binding D1 "DB". Revisa wrangler.jsonc.', { status: 500 });
}

// Guardar y redirigir: evita que recargar la pagina repita el ultimo cambio.
if (Astro.request.method === 'POST') {
  const formulario = await Astro.request.formData();
  const id = Number(formulario.get('id'));

  let espejoOk = true;

  if (Number.isInteger(id) && id > 0) {
    await actualizarSolicitud(db, id, {
      estado: String(formulario.get('estado') ?? '') || undefined,
      notas: formulario.has('notas') ? String(formulario.get('notas')).slice(0, 2000) : undefined,
    });

    // El calendario se alinea despues de guardar, no antes: si Google falla,
    // el cambio de estado igual quedo registrado.
    espejoOk = await sincronizar(db, id);
  }

  const destino = new URL(Astro.url);
  destino.searchParams.delete('aviso');
  if (!espejoOk) destino.searchParams.set('aviso', 'calendario');

  return Astro.redirect(`${destino.pathname}${destino.search}`, 303);
}

const filtro = Astro.url.searchParams.get('estado') ?? '';
const [solicitudes, totales] = await Promise.all([listarSolicitudes(db, filtro), contarPorEstado(db)]);
const total = Object.values(totales).reduce((a, b) => a + b, 0);

// Etiquetas de estado con la paleta de tags de Carbon (tono 20 de fondo, 70 de texto).
const COLORES: Record<string, string> = {
  nueva: 'bg-[#d0e2ff] text-[#0043ce]',
  contactada: 'bg-[#e8daff] text-[#6929c4]',
  agendada: 'bg-[#a7f0ba] text-[#0e6027]',
  completada: 'bg-superficie-2 text-tinta-media',
  cancelada: 'bg-[#ffd7d9] text-[#a2191f]',
};

const soloDigitos = (telefono: string) => telefono.replace(/\D/g, '');

const formatearFecha = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('es-PE', { weekday: 'short', day: 'numeric', month: 'short' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Solicitudes de visita</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-superficie">
    <header class="border-b border-filete bg-lienzo">
      <div class="contenedor flex h-12 items-center justify-between">
        <h1 class="cuerpo-sm font-semibold text-tinta">Solicitudes de visita</h1>
        <span class="leyenda text-tinta-media">{acceso.email}</span>
      </div>
    </header>

    <main class="contenedor py-8">
      {
        Astro.url.searchParams.get('aviso') === 'calendario' && (
          <p class="cuerpo-sm mb-6 border-l-[3px] border-advertencia bg-lienzo px-4 py-3 text-tinta" role="alert">
            El cambio se guardo, pero no se pudo actualizar Google Calendar. Revisa el evento a mano.
          </p>
        )
      }

      {/* Pestanas de Carbon: subrayado de 2px, no pastillas. */}
      <nav class="flex flex-wrap border-b border-filete">
        <a
          href="/solicitudes"
          class:list={[
            'cuerpo-sm flex min-h-12 items-center border-b-2 px-4',
            filtro === '' ? 'border-azul font-semibold text-tinta' : 'border-transparent text-tinta-media',
          ]}
        >
          Todas ({total})
        </a>
        {
          ESTADOS.map((estado) => (
            <a
              href={`/solicitudes?estado=${estado}`}
              class:list={[
                'cuerpo-sm flex min-h-12 items-center border-b-2 px-4 capitalize',
                filtro === estado ? 'border-azul font-semibold text-tinta' : 'border-transparent text-tinta-media',
              ]}
            >
              {estado} ({totales[estado] ?? 0})
            </a>
          ))
        }
      </nav>

      {
        solicitudes.length === 0 ? (
          <p class="mt-12 text-tinta-media">No hay solicitudes en esta vista.</p>
        ) : (
          <div class="mt-6 space-y-px">
            {solicitudes.map((solicitud) => (
              <article class="border border-filete bg-lienzo p-6">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <h2 class="subtitulo text-tinta">{solicitud.nombre}</h2>
                      <span
                        class:list={['leyenda px-2 py-1 font-semibold capitalize', COLORES[solicitud.estado]]}
                      >
                        {solicitud.estado}
                      </span>
                    </div>
                    <p class="cuerpo-sm mt-2 text-tinta-media">
                      {solicitud.distrito} — {solicitud.direccion}
                    </p>
                  </div>

                  <div class="text-right">
                    <p class="cuerpo-sm font-semibold text-tinta">{formatearFecha(solicitud.fecha_preferida)}</p>
                    <p class="leyenda text-tinta-media">{solicitud.franja}</p>
                  </div>
                </div>

                <dl class="cuerpo-sm mt-5 grid gap-x-6 gap-y-2 sm:grid-cols-2">
                  <div class="flex gap-2">
                    <dt class="text-tinta-media">Servicio:</dt>
                    <dd class="font-semibold text-tinta">{solicitud.tipo_servicio}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="text-tinta-media">Equipo:</dt>
                    <dd class="font-semibold text-tinta">{solicitud.tipo_equipo ?? '—'}</dd>
                  </div>
                  {solicitud.descripcion && (
                    <div class="flex gap-2 sm:col-span-2">
                      <dt class="shrink-0 text-tinta-media">Problema:</dt>
                      <dd class="text-tinta">{solicitud.descripcion}</dd>
                    </div>
                  )}
                </dl>

                <div class="mt-5 flex flex-wrap gap-px">
                  <a
                    href={`https://wa.me/${soloDigitos(solicitud.telefono)}`}
                    target="_blank"
                    rel="noopener"
                    class="boton boton-whatsapp"
                  >
                    WhatsApp
                  </a>
                  <a href={`tel:${soloDigitos(solicitud.telefono)}`} class="boton boton-terciario">
                    {solicitud.telefono}
                  </a>
                </div>

                <form method="POST" class="mt-5 flex flex-wrap items-end gap-4 border-t border-filete pt-5">
                  <input type="hidden" name="id" value={solicitud.id} />

                  <label class="block">
                    <span class="etiqueta-campo">Estado</span>
                    <select name="estado" class="campo capitalize">
                      {ESTADOS.map((estado) => (
                        <option value={estado} selected={estado === solicitud.estado}>
                          {estado}
                        </option>
                      ))}
                    </select>
                  </label>

                  <label class="block grow">
                    <span class="etiqueta-campo">Notas internas</span>
                    <input type="text" name="notas" value={solicitud.notas ?? ''} class="campo" />
                  </label>

                  <button type="submit" class="boton boton-primario">
                    Guardar
                  </button>
                </form>
              </article>
            ))}
          </div>
        )
      }
    </main>
  </body>
</html>
