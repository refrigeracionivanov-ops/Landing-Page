# Copia este archivo como `.env` y completa los valores.

# --- Sanity (contenido de la landing) -------------------------------------
# Los sacas de https://sanity.io/manage al crear el proyecto.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token con permiso de Editor. Sanity Manage > API > Tokens.
# Solo lo necesita `npm run sembrar`. El sitio publicado no lo usa.
SANITY_WRITE_TOKEN=

# --- Avisos por correo (opcional) ------------------------------------------
# Tier gratuito en https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=

# --- Quien entra a /solicitudes y /administrador ---------------------------
# En produccion hace falta UNA de las dos opciones de abajo. Sin ninguna, las
# dos paginas devuelven 403: es preferible que no carguen a que muestren datos
# de clientes sin saber quien esta del otro lado. En desarrollo quedan abiertas.

# Opcion A — Cloudflare Access. La buena: cada persona entra con su correo,
# queda registro de quien entro y se puede revocar a uno solo. Necesita un
# dominio propio; en un *.pages.dev o *.workers.dev no se puede usar.
#
# CF_ACCESS_TEAM_DOMAIN: tu dominio de equipo, ej. miempresa.cloudflareaccess.com
# CF_ACCESS_AUD: el "Application Audience (AUD) Tag" de la aplicacion en
#                Zero Trust > Access > Applications > tu app > Overview
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Opcion B — clave compartida, mientras no haya dominio propio. Una sola clave
# para todos, sin registro de quien entro y sin poder revocar a una persona
# sola. Se usa solo si las dos variables de Access estan vacias.
# Poné una larga y al azar; se escribe una vez cada 12 horas.
CLAVE_EDITOR=

# --- Google Calendar (opcional) --------------------------------------------
# Espeja las visitas agendadas. Si estas variables faltan, el espejo no ocurre
# y todo lo demas sigue funcionando igual.
#
# 1. En Google Cloud, crea una cuenta de servicio y descarga su clave JSON.
# 2. Habilita la Google Calendar API en ese proyecto.
# 3. En Google Calendar, compartí el calendario con el correo de la cuenta de
#    servicio, con permiso de "Hacer cambios en los eventos".
#
# GOOGLE_SA_PRIVATE_KEY: el campo `private_key` del JSON, en una sola linea y
#                        con los saltos escapados como \n.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires
