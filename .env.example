# Copia este archivo como `.env` y completa los valores.

# Sanity: los sacas de https://sanity.io/manage al crear el proyecto.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token con permiso de Editor. Sanity Manage > API > Tokens.
# Lo usa solo el endpoint /api/reservar para guardar las solicitudes.
SANITY_WRITE_TOKEN=

# Envio de correos de aviso al crear una solicitud (opcional para desarrollo).
# Tier gratuito en https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=
