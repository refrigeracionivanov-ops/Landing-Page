# Copia este archivo como `.env` y completa los valores.

# --- Sanity (contenido de la landing) -------------------------------------
# Los sacas de https://sanity.io/manage al crear el proyecto.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token con permiso de Editor. Sanity Manage > API > Tokens.
# Solo lo necesita `npm run sembrar`. El sitio publicado no lo usa.
SANITY_WRITE_TOKEN=

# --- Avisos por correo (opcional) ------------------------------------------
# Tier gratuito en https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=

# --- Cloudflare Access (protege /solicitudes) ------------------------------
# Solo hacen falta en produccion. En desarrollo la pagina queda abierta.
#
# CF_ACCESS_TEAM_DOMAIN: tu dominio de equipo, ej. miempresa.cloudflareaccess.com
# CF_ACCESS_AUD: el "Application Audience (AUD) Tag" de la aplicacion en
#                Zero Trust > Access > Applications > tu app > Overview
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
